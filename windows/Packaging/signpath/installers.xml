<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers": the two setups, built by
  build-release.ps1 -Stage Package from executables already signed through "binaries".
  SignPath cannot sign inside an Inno Setup installer, hence the second round.

  Inno Setup writes its version strings into fixed-width slots padded with spaces: the
  product name to 60 characters, the product version to 50. The name is constant, so it is
  checked here padded exactly as Inno writes it. The version is not: it changes with every
  release, and SignPath trims parameter values, so a padded version cannot reach this file.
  As SignPath support recommended, the installers carry no product-version restriction; the
  executables inside them are signed and version-checked by "binaries", and
  build-release.ps1 checks the installers' own version (trimmed) before they are submitted.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="NetFluss-Setup-${version}-x64.exe" product-name="NetFluss                                                    ">
      <authenticode-sign />
    </pe-file>
    <pe-file path="NetFluss-Setup-${version}-arm64.exe" product-name="NetFluss                                                    ">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
