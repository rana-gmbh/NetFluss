<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The NetFluss helper: a LocalSystem service hosting what an unelevated app cannot do
    itself — the Kernel-Network ETW trace behind Top Apps and the Network Slice, DNS changes
    without a UAC prompt each time, and adapter resets. The Windows counterpart of the macOS
    NetflussPrivilegedHelper, and optional in the same way: the app is fully useful without it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetFluss.Service</RootNamespace>
    <AssemblyName>NetFluss.Service</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- A service that idles nearly all day should not hold a server GC heap per core. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    A release publish carries its own runtime (build-release.ps1). One compressed file keeps
    that second runtime — the app has its own — to a fraction of its size, and the helper's
    installer copies whatever is in its folder, so a single file needs nothing special.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetFluss.Native.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetFluss.Core/NetFluss.Core.csproj" />
    <ProjectReference Include="../NetFluss.Native/NetFluss.Native.csproj" />
  </ItemGroup>

</Project>
