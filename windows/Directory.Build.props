<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!--
      TreatWarningsAsErrors only governs the compilers; warnings raised by MSBuild tasks
      pass straight through it. MSB3568 is GenerateResource reporting that two resource
      names folded together and it dropped one — a string silently missing from every
      language while the build stays green. It is the one MSBuild warning that has already
      bitten this project, so it is an error. Note it only fires on a full resgen: an
      incremental build skips the task and reports nothing.
    -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);MSB3568</MSBuildWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Only the languages NetFluss itself ships; the framework's other satellite folders
         would add a dozen directories of strings no one sees. -->
    <SatelliteResourceLanguages>en;de;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <Company>Rana GmbH</Company>
    <Product>NetFluss</Product>
    <Copyright>Copyright © 2026 Rana GmbH</Copyright>
    <Version>0.1.0</Version>
    <!--
      The product version is the release version and nothing else: the SDK would append
      "+<commit>", and code signing (SignPath Foundation) requires every signed file of a
      release — app, helper and installer — to carry the same product version.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Matches the macOS app's GPLv3 licensing. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
